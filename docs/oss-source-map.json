{
  "repository": "zixcel/zixcel-aws",
  "purpose": "Prepare bounded AWS operations and signing requests without making secrets part of the public contract.",
  "responsibility_boundary": "Own the named reusable integration/data mechanism. Product roles/UI and operational approvals stay with consumers; transport/custody reuse managed Crowsi components where capabilities fit. Planning-only APIs must remain clearly distinguished from implemented external operations.",
  "packages": [
    {
      "manifest": "Cargo.toml",
      "package": "zixcel-aws",
      "ecosystem": "rust",
      "description": "Credential-reference and SigV4 boundary for independent AWS integrations",
      "interfaces": {
        "lib": "src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [
          "adapters"
        ],
        "public_reexports": [
          "canonical::{CanonicalPreviewV1, canonical_preview}",
          "credential::AwsCredentialMaterial",
          "error::{AwsError, CredentialUseError, CredentialUseErrorCode}",
          "execute::{SystemClock, TrustedClock, execute, execute_with_clock}",
          "http_request::{HeaderV1, HttpRequestV1, QueryParameterV1, SigV4ParametersV1}",
          "plan::{SigningPlanStepV1, SigningPlanV1, prepare}",
          "port::{CredentialUsePort, CredentialUseRequest, sign_with_material}",
          "request::{\n    CredentialScopeV1, OperationModeV1, SignInputV1, SignOperationV1, SignRequestV1,\n    parse_sign_request,\n}",
          "response::{SensitiveHeaderValue, SignResponseV1, SigningReceiptV1}",
          "response_parse::parse_sign_response"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "crates/zixcel-aws-custody-adapter/Cargo.toml",
      "package": "zixcel-aws-custody-adapter",
      "ecosystem": "rust",
      "description": "Trusted in-process composition of Crowsi credential runtime and Zixcel AWS signing",
      "interfaces": {
        "lib": "crates/zixcel-aws-custody-adapter/src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [],
        "public_reexports": [
          "executor::ZixcelAwsCredentialExecutor"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    }
  ],
  "schema_definitions": [
    "schemas/sign-request-v1.schema.json",
    "schemas/sign-response-v1.schema.json"
  ],
  "test_sources": [
    "src/http_request.rs",
    "src/main.rs",
    "src/scope_validation.rs",
    "src/validation.rs",
    "tests/canonical_vectors.rs",
